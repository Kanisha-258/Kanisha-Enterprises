# ==========================================================================
#  Kanisha Enterprises — backend environment
#
#  Copy this file to `.env` and fill in the blanks:
#      cp .env.example .env
#
#  `.env` is git-ignored and must never be committed.
#  Everything below is read by the code — this list is generated from
#  every `process.env.*` reference in backend/.
# ==========================================================================


# --------------------------------------------------------------------------
#  REQUIRED — the server will not start without these
# --------------------------------------------------------------------------

# MongoDB connection string.
# Atlas: Dashboard -> Database Access -> copy the SRV string.
# Local:  mongodb://127.0.0.1:27017/kanisha
MONGODB_URI=

# Secret used to sign and verify login tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Rotating this signs every user out. Never commit a real value.
JWT_SECRET=


# --------------------------------------------------------------------------
#  Server
# --------------------------------------------------------------------------

# Port the API listens on.
PORT=5000

# Set to "production" in deployed environments. This is what stops the
# password-reset token from ever being returned in an API response, and it
# is a useful signal for any other environment-aware code you add.
NODE_ENV=development

# How long a signed-in session lasts.
JWT_EXPIRES_IN=7d


# --------------------------------------------------------------------------
#  CORS — which frontends may call this API
# --------------------------------------------------------------------------

# Comma-separated list of allowed origins. In production set this to your
# real site, e.g. https://kanishaenterprises.com
# Leaving it as localhost means the deployed site gets blocked by the browser.
CLIENT_URL=http://localhost:5173


# --------------------------------------------------------------------------
#  Delivery pricing
# --------------------------------------------------------------------------

# Flat delivery fee in rupees, charged when the order value is below the
# free-delivery threshold. Set to 0 to always deliver free.
SHIPPING_CHARGE=49

# Order value (rupees) at or above which delivery is free.
# The cart and checkout pages read these from the API, so changing them here
# updates the site automatically.
FREE_SHIPPING_ABOVE=999


# --------------------------------------------------------------------------
#  Password reset
# --------------------------------------------------------------------------

# How long a password-reset link stays valid, in minutes.
PASSWORD_RESET_TTL_MINUTES=60


# --------------------------------------------------------------------------
#  Payments (Razorpay) — optional
# --------------------------------------------------------------------------

# Leave BOTH blank to run in Cash-on-Delivery only mode. The checkout page
# hides the "Pay online" option automatically when these are not set.
# Keys: Razorpay Dashboard -> Settings -> API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# --------------------------------------------------------------------------
#  Admin seed script (optional)
# --------------------------------------------------------------------------

# Used by `npm run seed:admin` when no --email / --password flags are passed.
# Leaving ADMIN_PASSWORD blank makes the script generate a strong random
# password and print it once.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_PHONE=


# --------------------------------------------------------------------------
#  Test scripts (optional)
# --------------------------------------------------------------------------

# Base URL the test suites in scripts/ call. Only change this if your API
# is not running on the default port.
API_URL=http://localhost:5000/api
